{
    "actorSpecification": 1,
    "fields": {
        "type": "object",
        "properties": {
            "symbol": {
                "type": "string",
                "description": "Ticker symbol analyzed"
            },
            "name": {
                "type": "string",
                "description": "Full asset name"
            },
            "latestPrice": {
                "type": "number",
                "description": "Latest recorded closing price"
            },
            "currentSharpe": {
                "type": "number",
                "description": "Annualized Sharpe ratio (excess return / volatility)"
            },
            "currentSortino": {
                "type": "number",
                "description": "Annualized Sortino ratio (excess return / downside deviation)"
            },
            "calmarRatio": {
                "type": "number",
                "description": "Calmar ratio (annualized return / max drawdown)"
            },
            "maxDrawdownPct": {
                "type": "number",
                "description": "Maximum peak-to-trough drawdown percentage"
            },
            "avgDrawdownRecoveryDays": {
                "type": "number",
                "description": "Average business days to recover from drawdowns"
            },
            "annualizedVolatilityPct": {
                "type": "number",
                "description": "Annualized return standard deviation percentage"
            },
            "annualizedCagrPct": {
                "type": "number",
                "description": "Compound Annual Growth Rate percentage"
            },
            "valueAtRisk95Pct": {
                "type": "number",
                "description": "Daily 95% Value at Risk (VaR)"
            },
            "valueAtRisk99Pct": {
                "type": "number",
                "description": "Daily 99% Value at Risk (VaR)"
            },
            "expectedShortfall95Pct": {
                "type": "number",
                "description": "Daily 95% Conditional Value at Risk (CVaR / Expected Shortfall)"
            },
            "drawdownEvents": {
                "type": "array",
                "description": "List of historical drawdown and recovery periods",
                "items": {
                    "type": "object",
                    "additionalProperties": true
                }
            },
            "riskAssessment": {
                "type": "object",
                "description": "AI qualitative risk rating and summary",
                "additionalProperties": true
            },
            "dataProvider": {
                "type": "string",
                "description": "Market data source used"
            },
            "timestamp": {
                "type": "string",
                "description": "ISO 8601 calculation timestamp"
            },
            "longestDrawdownDays": {
                "type": "integer",
                "description": "Longest historical drawdown duration in business days"
            },
            "totalPeriodReturnPct": {
                "type": "number",
                "description": "Total cumulative return percentage over the analyzed horizon"
            },
            "analyticsHorizon": {
                "type": "object",
                "description": "Start date, end date, and trading days analyzed",
                "additionalProperties": true
            },
            "drawdownSeries": {
                "type": "object",
                "nullable": true,
                "description": "Daily drawdown time series",
                "additionalProperties": true
            },
            "rollingSharpeSeries": {
                "type": "object",
                "nullable": true,
                "description": "Rolling Sharpe ratio time series",
                "additionalProperties": true
            },
            "returnDistribution": {
                "type": "object",
                "nullable": true,
                "description": "50-bin return distribution and Gaussian fit",
                "additionalProperties": true
            }
        },
        "required": [],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": true
    },
    "views": {
        "overview": {
            "title": "Risk & Volatility Summary",
            "transformation": {
                "fields": [
                    "symbol",
                    "name",
                    "currentSharpe",
                    "currentSortino",
                    "maxDrawdownPct",
                    "avgDrawdownRecoveryDays",
                    "annualizedVolatilityPct",
                    "annualizedCagrPct"
                ]
            },
            "display": {
                "component": "table"
            }
        }
    }
}
